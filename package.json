{
  "name": "grabgpt-dev",
  "private": true,
  "description": "Orchestrates the GrabonGPT backend and frontend dev servers in a single terminal.",
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,green \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "cd backend && python main.py",
    "dev:frontend": "cd frontend && npm run dev"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
